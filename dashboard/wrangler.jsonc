{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The dashboard. Only reached through valkey-do's main URL (its DASHBOARD service binding), so no URL of its own.
  "name": "vado-dashboard",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "services": [{ "binding": "ADMIN", "service": "valkey-do", "entrypoint": "Admin" }]
}
