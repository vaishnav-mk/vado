{
  "name": "vado",
  "version": "0.0.0",
  "private": true,
  "description": "Valkey or Redis on Cloudflare Durable Objects: the real servers compiled to wasm, sharded behind a Worker",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vaishnav-mk/vado.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "deploy": "vp build && wrangler deploy",
    "check": "vp check && tsrs --noEmit --fast",
    "test": "vp test"
  },
  "dependencies": {
    "@cloudflare/kumo": "^2.19.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "~1.169.7",
    "@vado/server": "*",
    "d3-geo": "^3.1.2",
    "durability": "5.4.0",
    "echarts": "^6.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "topojson-client": "^3.1.0",
    "valibot": "1.5.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "~1.70.1",
    "@durability/lint": "0.4.0",
    "@oxlint/plugins": "1.94.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/d3-geo": "^3.1.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-react": "^6.3.0",
    "ioredis": "^5.4.1",
    "tailwindcss": "^4.3.5",
    "tsrs": "7.1.0-beta.tsrs4",
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8000",
    "vite-plus": "1.7.0",
    "wrangler": "^4.166.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8000"
  },
  "cloudflare": {
    "bindings": {
      "VALKEY_PASSWORD": {
        "description": "The password clients send with `AUTH <database> <password>`. It also opens WebSocket access (`/ws`). Generate one with `openssl rand -hex 32`."
      },
      "ACCESS_TEAM_DOMAIN": {
        "description": "Your Zero Trust team domain, like `https://<team>.cloudflareaccess.com`. See [Sign in](https://github.com/vaishnav-mk/vado#sign-in)."
      },
      "ACCESS_AUD": {
        "description": "The **Application Audience (AUD) tag** of the Access application on `/signin`."
      }
    }
  }
}
