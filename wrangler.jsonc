{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "valkey-do",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "durable_objects": {
    "bindings": [
      { "name": "SHARD", "class_name": "ValkeyShard" },
      { "name": "SHARD1", "class_name": "ValkeyShard1" },
      { "name": "SHARD2", "class_name": "ValkeyShard2" },
      { "name": "SHARD3", "class_name": "ValkeyShard3" },
      { "name": "SHARD4", "class_name": "ValkeyShard4" },
      { "name": "SHARD5", "class_name": "ValkeyShard5" },
      { "name": "SHARD6", "class_name": "ValkeyShard6" },
      { "name": "SHARD7", "class_name": "ValkeyShard7" },
      { "name": "SHARD8", "class_name": "ValkeyShard8" },
      { "name": "SHARD9", "class_name": "ValkeyShard9" },
      { "name": "SHARD10", "class_name": "ValkeyShard10" },
      { "name": "SHARD11", "class_name": "ValkeyShard11" },
      { "name": "SHARD12", "class_name": "ValkeyShard12" },
      { "name": "SHARD13", "class_name": "ValkeyShard13" },
      { "name": "SHARD14", "class_name": "ValkeyShard14" },
      { "name": "SHARD15", "class_name": "ValkeyShard15" },
      { "name": "REWRITER", "class_name": "ValkeyRewriter" },
      { "name": "REWRITER1", "class_name": "ValkeyRewriter1" },
      { "name": "REWRITER2", "class_name": "ValkeyRewriter2" },
      { "name": "REWRITER3", "class_name": "ValkeyRewriter3" },
      { "name": "REWRITER4", "class_name": "ValkeyRewriter4" },
      { "name": "REWRITER5", "class_name": "ValkeyRewriter5" },
      { "name": "REWRITER6", "class_name": "ValkeyRewriter6" },
      { "name": "REWRITER7", "class_name": "ValkeyRewriter7" },
      { "name": "CATALOG", "class_name": "Catalog" },
      { "name": "PULSE", "class_name": "Pulse" },
      { "name": "SENDER", "class_name": "Sender" },
      { "name": "WATCHER", "class_name": "Watcher" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Valkey"] },
    { "tag": "v2", "new_sqlite_classes": ["ValkeyShard", "Catalog"], "deleted_classes": ["Valkey"] },
    { "tag": "v3", "new_sqlite_classes": ["Pulse"] },
    { "tag": "v4", "new_sqlite_classes": ["Sender"] },
    { "tag": "v5", "new_sqlite_classes": ["ValkeyShard1", "ValkeyShard2", "ValkeyShard3", "ValkeyShard4", "ValkeyShard5", "ValkeyShard6", "ValkeyShard7"] },
    { "tag": "v6", "new_sqlite_classes": ["ValkeyRewriter"] },
    { "tag": "v7", "new_sqlite_classes": ["ValkeyRewriter1", "ValkeyRewriter2", "ValkeyRewriter3", "ValkeyRewriter4", "ValkeyRewriter5", "ValkeyRewriter6", "ValkeyRewriter7"] },
    { "tag": "v8", "new_sqlite_classes": ["ValkeyShard8", "ValkeyShard9", "ValkeyShard10", "ValkeyShard11", "ValkeyShard12", "ValkeyShard13", "ValkeyShard14", "ValkeyShard15"] },
    { "tag": "v9", "new_sqlite_classes": ["Watcher"] }
  ],
  // SELF: bench requests and the Admin API reach the TCP connect() handler the way a client Worker would.
  // DASHBOARD: the dashboard (dashboard/, Worker vado-dashboard) serves every request that isn't /ws, /live or the
  // bench API. The two bind to each other, so on a new account deploy this Worker once without DASHBOARD, then
  // the dashboard, then this Worker again (docs/operations.md).
  "services": [{ "binding": "SELF", "service": "valkey-do" }, { "binding": "DASHBOARD", "service": "vado-dashboard" }],
  "vars": {
    // Shard epochs: a database's creation time picks its shard count for life.
    // Databases created from this epoch on start at 1 shard (64 MB); create bigger ones explicitly.
    "SHARD_EPOCHS": "[{\"from\":0,\"shards\":16},{\"from\":1795002173433,\"shards\":1}]",
    "LOCATION_HINT": "apac"
  },
  // Each deploy's version id: a shard reports it, so the dashboard can tell a deploy from a crash.
  "version_metadata": { "binding": "VERSION" },
  "observability": { "enabled": true }
}
