using Workerd = import "/workerd/workerd.capnp";

# Local: TCP 127.0.0.1:6380 -> router (db "default"), HTTP 127.0.0.1:8787 -> admin/bench.
# DO SQLite on disk under .local-do/, so restarts and kill -9 exercise the AOF.
const config :Workerd.Config = (
  services = [
    (name = "main", worker = .worker),
    (name = "disk", disk = (path = ".local-do", writable = true)),
  ],
  sockets = [
    ( name = "valkey", address = "127.0.0.1:6380", tcp = (), service = "main" ),
    ( name = "http", address = "127.0.0.1:8787", http = (), service = "main" ),
  ],
);

const worker :Workerd.Worker = (
  modules = [
    # generated by scripts/local.sh from the wrangler bundle in .dist/
@MODULES@
