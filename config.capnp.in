using Workerd = import "/workerd/workerd.capnp";

# Local: TCP 127.0.0.1:6380 -> router (db "default"), HTTP 127.0.0.1:8787 -> admin/bench.
# DO SQLite on disk under .local-do/, so restarts and kill -9 exercise the AOF.
const config :Workerd.Config = (
  services = [
    (name = "main", worker = .worker),
    (name = "disk", disk = (path = ".local-do", writable = true)),
  ],
  sockets = [
    ( name = "valkey", address = "127.0.0.1:6380", tcp = (), service = "main" ),
    ( name = "http", address = "127.0.0.1:8787", http = (), service = "main" ),
  ],
);

const worker :Workerd.Worker = (
  modules = [
    # generated by scripts/local.sh from the wrangler bundle in .dist/
@MODULES@
  ],
  compatibilityDate = "2026-11-01",
  compatibilityFlags = ["nodejs_compat", "experimental"],
  durableObjectNamespaces = [
    (className = "ValkeyShard", uniqueKey = "valkey-shard", enableSql = true),
    (className = "Catalog", uniqueKey = "catalog", enableSql = true),
    (className = "Pulse", uniqueKey = "pulse", enableSql = true),
  ],
  durableObjectStorage = (localDisk = "disk"),
  bindings = [
    (name = "SHARD", durableObjectNamespace = "ValkeyShard"),
    (name = "CATALOG", durableObjectNamespace = "Catalog"),
    (name = "PULSE", durableObjectNamespace = "Pulse"),
    (name = "SELF", service = "main"),
    (name = "BENCH_TOKEN", text = "@BENCH_TOKEN@"),
    (name = "SHARD_EPOCHS", text = "[{\"from\":0,\"shards\":4}]"),
    (name = "VALKEY_LOGLEVEL", text = "notice"),
    (name = "ROUTER_SOCKET_BUDGET", text = "@BUDGET@"),
    (name = "VALKEY_PASSWORD", text = "@PASSWORD@"),
    (name = "ROUTER_IDLE_MS", text = "@IDLE_MS@"),
  ],
);
