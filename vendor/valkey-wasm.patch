-    }
+    aeApiGrow(eventLoop->apidata, setsize);
     return 0;
 }
 
 static void aeApiFree(aeEventLoop *eventLoop) {
-    zfree(eventLoop->apidata);
+    aeApiState *state = eventLoop->apidata;
+    zfree(state->fds);
+    zfree(state->pos);
+    zfree(state);
